#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
DEV_ID="$(printf '%s' "$ROOT" | cksum | awk '{print $1}')"
NAME="${KUBA_NAME:-default}"

case "$NAME" in
  ""|*[!A-Za-z0-9_-]*)
    echo "invalid KUBA_NAME: $NAME" >&2
    exit 2
    ;;
esac

export KUBA_HOME="${KUBA_HOME:-$ROOT/.kuba-browser-dev}"
if [ -z "${KUBA_RUNTIME_DIR:-}" ]; then
  export KUBA_RUNTIME_DIR="/tmp/kuba-dev-$DEV_ID/runtime"
  export KUBA_RUNTIME_DIR_SHARED="${KUBA_RUNTIME_DIR_SHARED:-1}"
fi
if [ -z "${KUBA_TMP_DIR:-}" ]; then
  export KUBA_TMP_DIR="$KUBA_HOME/tmp"
  export KUBA_TMP_DIR_SHARED="${KUBA_TMP_DIR_SHARED:-1}"
fi

if [ -x "$ROOT/.venv/bin/python" ]; then
  exec "$ROOT/.venv/bin/python" -m kuba_browser.run "$@"
fi

if command -v uv >/dev/null 2>&1; then
  exec uv --directory "$ROOT" run python -m kuba_browser.run "$@"
fi

export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m kuba_browser.run "$@"
