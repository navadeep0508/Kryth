{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default KRYTH Desktop capability",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
