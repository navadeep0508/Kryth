{
  "identifier": "default",
  "description": "Default KRYTH Desktop capability",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main", "browser"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-create",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:app:default",
    "core:resources:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}