# ============================================
# KRYTH - Autonomous AI Coding Agent
# Environment Configuration
# ============================================

# Required: OpenAI API Key (or other provider)
OPENAI_API_KEY=your-api-key-here

# Optional: Base URL for API (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Model configuration
# MAIN_MODEL=gpt-4-turbo-preview
# PLANNER_MODEL=gpt-4-turbo-preview
# SUMMARIZER_MODEL=gpt-4-turbo-preview

# Optional: Authentication for alternative providers
# ANTHROPIC_API_KEY=your-anthropic-key
# GEMINI_API_KEY=your-gemini-key
# GROQ_API_KEY=your-groq-key
# TOGETHER_API_KEY=your-together-key

# Optional: Bridge configuration (for browser-based auth)
# BRIDGE_PORT=8765
# BRIDGE_PROVIDER=gemini

# Optional: Session and persistence
# AICODER_NO_RESUME=false
# AICODER_PROFILE=default
# AICODER_ASSUME_YES=false

# Optional: Logging
# LOG_LEVEL=INFO
# LOG_FILE=~/.kryth/kryth.log

# Optional: Performance
# MAX_TOKENS=4096
# REQUEST_TIMEOUT=60

# Optional: Development
# DEBUG=false
# PYTHONPATH=./src

# Optional: Git configuration
# GIT_AUTO_COMMIT=false